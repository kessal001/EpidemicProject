@page "/"
@page "/simulazione"

<PageTitle>Simulatore SIR — Epidemic Lab</PageTitle>

<section class="hero">
    <div>
        <p class="eyebrow">Progetto di maturità · edizione 2026</p>
        <h1>Come si diffonde<br />un’epidemia?</h1>
        <p class="lead">Esplora il modello SIR, modifica i parametri e osserva come cambia la curva degli infetti.</p>
    </div>
    <div class="hero-stat">
        <span>R₀</span>
        <strong>@Model.BasicReproductionNumber.ToString("0.00")</strong>
        <small>@ReproductionLabel</small>
    </div>
</section>

<section class="workspace">
    <aside class="control-panel">
        <div class="section-heading">
            <div><span>01</span><h2>Parametri</h2></div>
            <button class="text-button" @onclick="Reset">Ripristina</button>
        </div>

        <label>Suscettibili <output>@Format(Model.SusceptiblePopulation)</output></label>
        <input type="range" min="0" max="1000000" step="1000" @bind="Model.SusceptiblePopulation" @bind:event="oninput" @bind:after="Run" />

        <label>Infetti iniziali <output>@Format(Model.InfectedPopulation)</output></label>
        <input type="range" min="0" max="100000" step="100" @bind="Model.InfectedPopulation" @bind:event="oninput" @bind:after="Run" />

        <label>Rimossi iniziali <output>@Format(Model.RemovedPopulation)</output></label>
        <input type="range" min="0" max="500000" step="1000" @bind="Model.RemovedPopulation" @bind:event="oninput" @bind:after="Run" />

        <div class="input-grid">
            <label>Beta <small>contagio</small><input type="number" min="0" max="5" step="0.01" @bind="Model.Beta" @bind:after="Run" /></label>
            <label>Gamma <small>rimozione</small><input type="number" min="0.01" max="5" step="0.01" @bind="Model.Alpha" @bind:after="Run" /></label>
            <label>Giorni <input type="number" min="1" max="2000" @bind="Model.Days" @bind:after="Run" /></label>
        </div>

        <div class="presets">
            <span>Scenari rapidi</span>
            <button @onclick="() => ApplyPreset(.18, .12)">Contenuta</button>
            <button @onclick="() => ApplyPreset(.30, .10)">Standard</button>
            <button @onclick="() => ApplyPreset(.55, .08)">Aggressiva</button>
        </div>
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <p class="error-message">@ErrorMessage</p>
        }
    </aside>

    <div class="results-panel">
        <div class="section-heading">
            <div><span>02</span><h2>Andamento</h2></div>
            <div class="legend"><i class="s"></i>Suscettibili <i class="i"></i>Infetti <i class="r"></i>Rimossi</div>
        </div>
        <SirChart Data="Results" />
        <div class="metrics">
            <article><small>Picco infetti</small><strong>@Format(Peak.Infected)</strong><span>giorno @Peak.Day.ToString("0")</span></article>
            <article><small>Popolazione</small><strong>@Format(Model.TotalPopulation)</strong><span>totale iniziale</span></article>
            <article><small>Infetti finali</small><strong>@Format(Results.LastOrDefault()?.Infected ?? 0)</strong><span>dopo @Model.Days giorni</span></article>
        </div>
    </div>
</section>

<section class="data-section">
    <div class="section-heading"><div><span>03</span><h2>Dati della simulazione</h2></div><button class="text-button" @onclick="() => ShowData = !ShowData">@(ShowData ? "Nascondi" : "Mostra tabella")</button></div>
    @if (ShowData)
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Giorno</th><th>Suscettibili</th><th>Infetti</th><th>Rimossi</th></tr></thead>
                <tbody>
                    @foreach (var row in Results.Where((_, index) => index % Math.Max(1, Results.Count / 20) == 0 || index == Results.Count - 1))
                    {
                        <tr><td>@row.Day.ToString("0")</td><td>@Format(row.Susceptible)</td><td>@Format(row.Infected)</td><td>@Format(row.Removed)</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private SIRClass Model { get; set; } = new();
    private IReadOnlyList<SIRStat> Results { get; set; } = [];
    private bool ShowData { get; set; }
    private string? ErrorMessage { get; set; }
    private SIRStat Peak => Results.Count == 0 ? new(0, 0, 0, 0) : Results.MaxBy(x => x.Infected)!;
    private string ReproductionLabel => Model.BasicReproductionNumber switch { < 1 => "epidemia in calo", < 2 => "diffusione moderata", _ => "diffusione sostenuta" };

    protected override void OnInitialized() => Run();

    private void Run()
    {
        try { Results = Model.Simulate(); ErrorMessage = null; }
        catch (Exception ex) { ErrorMessage = ex.Message; }
    }

    private void Reset() { Model = new(); Run(); }
    private void ApplyPreset(double beta, double gamma) { Model.Beta = beta; Model.Alpha = gamma; Run(); }
    private static string Format(double value) => Math.Round(value).ToString("N0", CultureInfo.GetCultureInfo("it-IT"));
}
